# TSB-HB v2 experiment config
# Edit this file, then run:
#   bash scripts/experiments/run_v2_suite.sh scripts/experiments/config.v2.env

OUT_ROOT="outputs/tsbhb_v2"
SEED=42
WALK_STEP=7

# Which experiment groups to run
RUN_ONLINE_POINT_FIXED=1
RUN_ONLINE_POINT_WALK=1
RUN_ONLINE_PROB_FIXED=1
RUN_ONLINE_PROB_WALK=1
RUN_M5_POINT=1

# Common TSB-HB switches
HB_REGIME_AWARE=1
HB_GROUP_SHRINK_STRENGTH=10.0
HB_ONLINE_UPDATE=1
HB_DYNAMIC_OCCURRENCE=1
HB_OCC_DISCOUNT=0.98

# Probabilistic switches
HB_BOOTSTRAP_DRAWS=20
HB_USE_HYPER_UNCERTAINTY=1
HB_CALIBRATION_MODE="none"            # none | location_scale
HB_CALIBRATION_RATIO=0.20
HB_CALIBRATION_SAMPLES=1000

# Optional DeepAR baseline in probabilistic fixed protocol
WITH_DEEPAR=0
DEEPAR_HORIZON=10
DEEPAR_INPUT_SIZE=14
DEEPAR_MAX_STEPS=500

# M5 switches
M5_SAMPLE_SIZE=5000
M5_HIERARCHY_MODE="ablation"           # off | on | ablation
