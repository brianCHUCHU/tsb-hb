# Canonical reproduction config for Hummer_noHurdle.tex
# Run with:
#   bash scripts/experiments/run_paper_suite.sh scripts/experiments/config.paper.env

OUT_ROOT="outputs/paper_reproduction"
SEED=42
WALK_STEP=7
M5_SAMPLE_SIZE=5000

RUN_ONLINE_POINT_FIXED=1
RUN_ONLINE_PROB_FIXED=1
RUN_ONLINE_POINT_WALK=1
RUN_ONLINE_PROB_WALK=0
RUN_M5_POINT=1

POINT_BASELINE_MODE="paper"
PROB_BASELINE_MODE="paper"
WITH_DEEPAR=0

